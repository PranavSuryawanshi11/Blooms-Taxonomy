# =========================================================================
# BloomCraft AI - Git Ignore Rules
# =========================================================================

# Secrets and Environment Variables (NEVER commit secrets or API keys)
.env
*.env
.env.*
.env.local
.env.development
.env.production
backend/.env
backend/*.env
backend/.env.*

# Always preserve template files
!.env.example
!backend/.env.example

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# User Data & Private Faculty Stores (keeps faculty exam papers isolated)
backend/data/user_store.json
user_store.json
*.sqlite
*.sqlite3
*.db

# Project Packaging & Export Zips
*.zip
bloomcraft_ai_project.zip
*.tar.gz

# Logs & Temporary Files
*.log
logs/
*.tmp
*.temp

# IDEs & Operating System Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

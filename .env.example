# =========================================================================
# BloomCraft AI - Environment Configuration Template
# Copy this file to '.env' and insert your API keys as needed.
# =========================================================================

# Groq Cloud API Key (https://console.groq.com/keys) - Free Tier Available
GROQ_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys) - Supports ":free" models
OPENROUTER_API_KEY=

# Cerebras Cloud API Key (https://cloud.cerebras.ai) - Free Tier Available
CEREBRAS_API_KEY=

# Mistral AI API Key (https://console.mistral.ai) - Free "Experiment" Tier
MISTRAL_API_KEY=

# Optional: Preferred Provider Order (default: mistral,cerebras,groq,openrouter)
# BLOOMCRAFT_LLM_ORDER=mistral,cerebras,groq,openrouter

# Optional: Server Port & Host Configuration
# PORT=5000
# FLASK_DEBUG=0

